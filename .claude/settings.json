{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "gds-base": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  },
  "enabledPlugins": {
    "pixi-pyright@gds-base": true
  }
}
